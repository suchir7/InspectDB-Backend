# Production settings used by docker-compose.yml on the EC2 server.
# Copy to .env.production and fill in. Never commit .env.production.
# Keep values unquoted and avoid "$" characters (Docker Compose interpolates them).

# ---- Web server (Caddy) ----
# :80 serves plain HTTP on the server IP.
# For free automatic HTTPS, use your Elastic IP with dashes + .sslip.io, e.g. 3-91-20-15.sslip.io
# (the CloudFormation output "HttpsSiteAddress" gives you this value), or your own domain.
SITE_ADDRESS=:80

# ---- Inspection documents: Amazon DocumentDB ----
STORAGE_MODE=documentdb
# CloudFormation output "DocumentDBUri" (credentials are supplied separately below)
DOCUMENTDB_URI=mongodb://your-cluster.cluster-abc123.us-east-1.docdb.amazonaws.com:27017/?tls=true&replicaSet=rs0&retryWrites=false
DOCUMENTDB_USERNAME=inspectdbadmin
DOCUMENTDB_PASSWORD=change-me
DOCUMENTDB_DATABASE=inspectdb
DOCUMENTDB_COLLECTION=inspection_reports
DOCUMENTDB_TARGET_VERSION=5.0

# ---- User accounts / authentication: Neon PostgreSQL ----
DATABASE_URL=postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# ---- Google Gemini (optional; deterministic fallbacks are used when empty) ----
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MAX_QUERY_RESULTS=20
