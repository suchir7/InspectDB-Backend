# Backend Environment Configuration
ENVIRONMENT=development
API_V1_STR=/api
PROJECT_NAME="InspectDB - Amazon DocumentDB Inspection Management System"
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Neon PostgreSQL Relational Database (Authentication & User/Application Data)
# Neon Connection String with SSL requirement:
DATABASE_URL=postgresql://username:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE_MINUTES=1440

# Google Gemini AI API Configuration (For Natural-Language Query Assistant & Cost Advisor)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Storage Mode Configuration:
#   "memory"     - In-Memory Repository (data lost on restart)
#   "mongodb"    - Local MongoDB (MONGODB_* below)
#   "documentdb" - Amazon DocumentDB cluster (DOCUMENTDB_* below)
STORAGE_MODE=memory

# Local MongoDB Development Database (For Local Query Execution Testing)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=inspectdb
MONGODB_COLLECTION=inspection_reports
MAX_QUERY_RESULTS=20
MONGODB_TIMEOUT_MS=2000

# Amazon DocumentDB Configuration (used when STORAGE_MODE=documentdb)
# DocumentDB is only reachable from inside its VPC (e.g. the EC2 app server) - see DEPLOYMENT.md
DOCUMENTDB_URI=mongodb://docdb-cluster.cluster-xyz.us-east-1.docdb.amazonaws.com:27017/?tls=true&replicaSet=rs0&retryWrites=false
# Credentials are passed separately so special characters need no URL-encoding
DOCUMENTDB_USERNAME=inspectdbadmin
DOCUMENTDB_PASSWORD=your_documentdb_password
DOCUMENTDB_DATABASE=inspectdb
DOCUMENTDB_COLLECTION=inspection_reports
# TLS CA bundle: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem (relative to backend/)
DOCUMENTDB_TLS=true
DOCUMENTDB_TLS_CA_FILE=global-bundle.pem
DOCUMENTDB_TIMEOUT_MS=5000
DOCUMENTDB_TARGET_VERSION=5.0
